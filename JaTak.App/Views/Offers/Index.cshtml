@model List<OfferViewModel>

@{
    ViewData["Title"] = "Ja Tak tilbud";
}

<div class="offers-container">

    <h1 class="offers-title">Ja Tak tilbud</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Luk">
            </button>
        </div>
    }

    <div class="offers-grid"> 

        @foreach (var offer in Model)
        {
            <!-- Clickable offer card that opens the corresponding modal. -->
            <div class="offer-card"
                 role="button"
                 tabindex="0"
                 data-bs-toggle="modal"
                 data-bs-target="#offer-@offer.OfferId">

                <div class="offer-image">
                    <img src="~/images/@offer.ImageUrl"
                         alt="@offer.ProductName" />
                </div>

                <div class="offer-information">

                    <h3>@offer.ProductName</h3>

                    <div class="offer-bottom">

                        <span class="offer-location">
                            @offer.ShopName
                        </span>

                        <span class="offer-price">
                            @offer.Price.ToString("N2",
                                new System.Globalization.CultureInfo("da-DK")) kr.
                        </span>

                    </div>

                @{
                        string stockText;
                        string stockColorClass;

                        if (offer.QuantityLeft <= 0)
                        {
                            stockText = "Udsolgt";
                            stockColorClass = "stock-red";
                        }
                        else
                        {
                            double ratio = offer.Quantity > 0
                                ? (double)offer.QuantityLeft / offer.Quantity
                                : 0;

                            stockText = $"{offer.QuantityLeft} tilbage";

                            if (ratio < 0.25)
                            {
                                stockColorClass = "stock-red";
                            }
                            else if (ratio < 0.50)
                            {
                                stockColorClass = "stock-orange";
                            }
                            else
                            {
                                stockColorClass = "stock-green";
                            }
                        }
                    }

                    <div class="offer-stock @stockColorClass">
                        @if (offer.QuantityLeft == 0)
                        {
                            <span class="stock-dot"></span>
                            <span>UDSOLGT</span>
                        }
                        else if (stockColorClass == "stock-green" ||
                                 stockColorClass == "stock-orange")
                        {
                            <span class="stock-dot"></span>
                            <span>@offer.QuantityLeft TILBAGE</span>
                        }
                        else
                        {
                            <span class="stock-dot"></span>
                            <span>KUN @offer.QuantityLeft TILBAGE!</span>
                        }
                    </div>

                </div>

            </div>
        }

    </div>

</div>

<!-- Creates a separate details modal for each offer. -->
@foreach (var offer in Model)
{
    <div class="modal fade"
         id="offer-@offer.OfferId"
         tabindex="-1"
         aria-labelledby="offer-title-@offer.OfferId"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered offer-details-dialog">

            <div class="modal-content offer-details">

                <!-- Modal header containing the close button. -->
                <div class="modal-header offer-details-header">

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Luk">
                    </button>

                </div>

                <!-- Offer information. -->
                <div class="modal-body offer-details-body">

                    <img src="~/images/@offer.ImageUrl"
                         alt="@offer.ProductName"
                         class="offer-details-image" />

                    <h3 id="offer-title-@offer.OfferId">
                        @offer.ProductName
                    </h3>

                    <p>
                        Butik: @offer.ShopName
                    </p>

                    <p>
                        Beskrivelse: @offer.Description
                    </p>

                    <p>
                        Afhentningssted: @offer.PickupPoint
                    </p>

                    @if (offer.PickupStartDateTime.HasValue &&
                         offer.PickupEndDateTime.HasValue)
                    {
                        <p>
                            Afhentning:
                            @offer.PickupStartDateTime.Value.ToString("dd-MM-yyyy")
                            kl.
                            @offer.PickupStartDateTime.Value.ToString("HH:mm")–@offer.PickupEndDateTime.Value.ToString("HH:mm")
                        </p>
                    }
                    else
                    {
                        <p>
                            Afhentningstid: Ikke angivet
                        </p>
                    }

                    <p>
                        Pris:
                        @offer.Price.ToString("N2", new System.Globalization.CultureInfo("da-DK")) kr.
                        (før @offer.OriginalPrice.ToString("N2", new System.Globalization.CultureInfo("da-DK")) kr.)
                    </p>

                    <p>
                        Tilbage: @offer.QuantityLeft af @offer.Quantity
                    </p>

                </div>

                <!-- Reservation area containing the Ja Tak button. -->
                <div class="modal-footer offer-details-footer">

                    @if (offer.QuantityLeft > 0)
                    {
                        <form asp-controller="Offers"
                              asp-action="CreateReservation"
                              method="post"
                              class="jatak-reservation-form"
                              data-product-name="@offer.ProductName"
                              data-price="@offer.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              data-logged-in="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="offerId"
                                   value="@offer.OfferId" />

                            <!-- Lets the user choose how many items to reserve. -->
                            <div class="jatak-quantity-row">

                                <label for="quantity-@offer.OfferId"
                                       class="jatak-quantity-label">
                                    Antal
                                </label>

                                <input type="number"
                                       id="quantity-@offer.OfferId"
                                       name="quantity"
                                       class="form-control jatak-quantity-input"
                                       value="1"
                                       min="1"
                                       max="@offer.QuantityLeft"
                                       data-offer-id="@offer.OfferId" />

                            </div>

                            <button type="submit"
                                    class="btn btn-jatak rounded-pill px-5 jatak-reserve-button"
                                    data-offer-id="@offer.OfferId">
                                Ja Tak!
                            </button>

                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary rounded-pill px-5 jatak-reserve-button"
                                disabled>
                            Udsolgt
                        </button>
                    }

                </div>

            </div>

        </div>

    </div>
}

<!-- Asks the customer to confirm the reservation before it is sent. -->
<div class="modal fade"
     id="reservationConfirmModal"
     tabindex="-1"
     aria-labelledby="reservationConfirmTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="reservationConfirmTitle">
                    Bekræft reservation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Luk">
                </button>

            </div>

            <div class="modal-body">

                <p>Vil du gennemføre denne reservation?</p>

                <p class="mb-1">Produkt: <strong id="confirm-product-name"></strong></p>
                <p class="mb-1">Antal: <strong id="confirm-quantity"></strong></p>
                <p class="mb-1">Pris pr. stk.: <strong id="confirm-price"></strong></p>
                <p class="mb-0">Pris i alt: <strong id="confirm-total-price"></strong></p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        id="confirm-cancel-button">
                    Annuller
                </button>

                <button type="button"
                        class="btn btn-jatak rounded-pill px-4"
                        id="confirm-reservation-button">
                    Ja, reserver
                </button>

            </div>

        </div>

    </div>

</div>

<!-- Reservation confirmation popup. -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="modal fade"
         id="reservationSuccessModal"
         tabindex="-1"
         aria-labelledby="reservationSuccessTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="reservationSuccessTitle">
                        Reservation gennemført!
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Luk">
                    </button>

                </div>

                <div class="modal-body text-center">

                    <div class="mb-3">
                        <span class="jatak-success-icon">
                            ✓
                        </span>
                    </div>

                    <p>@TempData["SuccessMessage"]</p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-jatak rounded-pill px-4"
                            data-bs-dismiss="modal">
                        Luk
                    </button>

                </div>

            </div>

        </div>

    </div>
}

<!-- Login required popup. -->
@if (TempData["LoginRequiredMessage"] != null)
{
    <div class="modal fade"
         id="loginRequiredModal"
         tabindex="-1"
         aria-labelledby="loginRequiredTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="loginRequiredTitle">
                        Login påkrævet
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Luk">
                    </button>

                </div>

                <div class="modal-body text-center">
                    <p>@TempData["LoginRequiredMessage"]</p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">
                        Luk
                    </button>

                    <a asp-controller="Offers"
                       asp-action="Login"
                       class="btn btn-jatak rounded-pill px-4">
                        Log ind
                    </a>

                </div>

            </div>

        </div>

    </div>
}



