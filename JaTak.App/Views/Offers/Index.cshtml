@model List<JaTakApp.Models.OfferViewModel>

@{
    ViewData["Title"] = "Ja Tak tilbud";
}

<div class="offers-container">

    <h1 class="offers-title">Ja Tak tilbud</h1>

    <div class="offers-grid">

        @foreach (var offer in Model)
        {
            <div class="offer-card" data-bs-toggle="modal" data-bs-target="#offer-@offer.OfferId">

                <div class="offer-image">
                    <img src="~/images/@offer.ImageUrl"
                         alt="@offer.ProductName" />
                </div>

                <div class="offer-information">

                    <h3>@offer.ProductName</h3>

                    <div class="offer-bottom">

                        <span class="offer-location">
                            @offer.ShopName
                        </span>

                        <span class="offer-price">
                            @offer.Price.ToString("N2",
                                new System.Globalization.CultureInfo("da-DK")) kr.
                        </span>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@foreach (var offer in Model)
{
    <div class="modal fade" id="offer-@offer.OfferId">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <img src="~/images/@offer.ImageUrl" alt="@offer.ProductName" width="200" />
                    <h3>@offer.ProductName</h3>
                    <p>Butik: @offer.ShopName</p>
                    <p>Beskrivelse: @offer.Description</p>
                    <p>Afhentning: @offer.PickupPoint</p>
                    <p>Pris: @offer.Price kr. (før @offer.OriginalPrice kr.)</p>
                    <p>Tilbage: @offer.QuantityLeft af @offer.Quantity</p>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Luk</button>
                </div>
            </div>
        </div>
    </div>
}