@model List<JaTak.App.ViewModels.ReservationOverviewViewModel>
@{
    ViewData["Title"] = "Mine reservationer";
}

<div class="my-reservations-container">

    <div class="my-reservations-header">

        <h1>Mine reservationer</h1>

        <div class="reservation-tabs">
            <button type="button" class="reservation-tab active">
                Aktive
            </button>

            <button type="button" class="reservation-tab">
                Afsluttet
            </button>
        </div>

    </div>

    <div class="reservations-content">

    <div id="active-reservations" class="reservation-list">

        @foreach (var reservation in Model.Where(r => !r.IsCompleted))
        {
            <div class="reservation-item">
                <span class="reservation-status active"></span>
                <span class="reservation-name">@reservation.ProductName</span>
            </div>
        }

    </div>

    <div id="completed-reservations" class="reservation-list" style="display: none;">

        @foreach (var reservation in Model.Where(r => r.IsCompleted))
        {
            <div class="reservation-item">
                <span class="reservation-status completed"></span>
                <span class="reservation-name">@reservation.ProductName</span>
            </div>
        }

    </div>

</div>