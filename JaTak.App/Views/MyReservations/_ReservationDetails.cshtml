@model JaTak.App.ViewModels.ReservationDetailsViewModel

<div class="reservation-details">

    <img src="~/images/@Model.ImageUrl" alt="@Model.ProductName" class="reservation-details-image" />

    <h4>@Model.ProductName</h4>

    <p>
        <span class="reservation-status @(Model.IsCompleted ? "completed" : "active")"></span>
        @(Model.IsCompleted ? "Afsluttet" : "Aktiv")
    </p>

    <p><strong>Butik:</strong> @Model.ShopName</p>
    <p><strong>Adresse:</strong> @Model.ShopAddress</p>
    <p><strong>Antal:</strong> @Model.Quantity stk.</p>
    <p><strong>Afhentning:</strong> @Model.PickupStartDateTime?.ToString("dd-MM-yyyy HH:mm") - @Model.PickupEndDateTime?.ToString("HH:mm")</p>
    <p><strong>Afhentningskode:</strong> @Model.PickupCode</p>

</div>